{
  "installCommand": "pnpm install",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "muhub.cn" }],
      "destination": "https://www.muhub.cn/:path*",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/cron/daily-discovery",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/ai-update",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/source-update",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/summary-update",
      "schedule": "0 6 * * 1"
    },
    {
      "path": "/api/cron/track-official-info",
      "schedule": "0 8 * * 3"
    }
  ]
}
